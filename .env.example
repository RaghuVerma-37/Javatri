# Copy to .env and fill in. Nothing here is secret — .env itself is gitignored.

# --- Database (required) -----------------------------------------------------
# Any Postgres. The app connects through the pg driver adapter in src/lib/db.ts.
#
# Supabase gives you two connection strings, and they are not interchangeable:
#
#   DATABASE_URL  the *pooled* one (Transaction mode, port 6543). What the app runs on.
#                 Keep ?pgbouncer=true — without it Prisma prepares statements the pooler
#                 cannot hold, and queries fail intermittently under load rather than at once.
#   DIRECT_URL    the *direct* one (Session mode, port 5432). Only the Prisma CLI uses it, for
#                 migrations: DDL and migration advisory locks cannot run through a transaction
#                 pooler. Leave it unset for a plain local Postgres and migrations use
#                 DATABASE_URL.
#
# Supabase dashboard → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgres://user:password@localhost:5432/javatri
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Admin sign-in (required) ------------------------------------------------
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Javatri
# Optional. Unset, the seed generates one and prints it once.
# ADMIN_PASSWORD=

# --- Site --------------------------------------------------------------------
# Used for canonical URLs, sitemap and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (optional) -----------------------------------------------------
# Without these the site still runs: the checkout page tells customers to phone
# instead of showing them a card form that cannot charge anything.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email (optional) --------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the terminal instead of sent, so
# you can place test orders without emailing anybody.
# RESEND_API_KEY=
# EMAIL_FROM="Javatri <orders@example.com>"
# KITCHEN_EMAIL=kitchen@example.com
# EVENTS_EMAIL=events@example.com
